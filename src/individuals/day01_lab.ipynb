        "# 🧩 TODO 3.1 — Cosine similarity\n",
        "def cosine_similarity(a, b) -> float:\n",
        "    \"\"\"a·b / (||a||·||b||). Một vector toàn 0 -> trả về 0.0\"\"\"\n",
        "    norm_a = np.linalg.norm(a)\n",
        "    norm_b = np.linalg.norm(b)\n",
        "    if norm_a == 0 or norm_b == 0:\n",
        "        return 0.0\n",
        "    return float(np.dot(a, b) / (norm_a * norm_b))\n",
        "\n",
        "# 🧩 TODO 3.2 — Tìm k tin nhắn gần nghĩa nhất\n",
        "def top_k_similar(q, M, k: int = 5):\n",
        "    \"\"\"\n",
        "    q: vector (d,), M: ma trận (n, d). Trả về (idx, scores): k chỉ số có cosine cao nhất (giảm dần) và điểm tương ứng.\n",
        "    Gợi ý: chuẩn hoá q và từng dòng của M về độ dài 1 -> cosine = tích vô hướng. Dùng np.argsort.\n",
        "    Yêu cầu: KHÔNG dùng vòng lặp Python qua n dòng (n ~ 3.600) — hãy dùng phép nhân ma trận.\n",
        "    \"\"\"\n",
        "    # Chuẩn hóa q về độ dài 1\n",
        "    norm_q = np.linalg.norm(q)\n",
        "    q_norm = q / norm_q if norm_q > 0 else q\n",
        "\n",
        "    # Chuẩn hóa từng dòng của M về độ dài 1 (thêm 1e-9 để tránh chia cho 0)\n",
        "    norms_M = np.linalg.norm(M, axis=1, keepdims=True)\n",
        "    norms_M[norms_M == 0] = 1e-9\n",
        "    M_norm = M / norms_M\n",
        "\n",
        "    # Tính cosine similarity cho toàn bộ n dòng bằng phép nhân ma trận (vector-matrix product)\n",
        "    scores = np.dot(M_norm, q_norm)\n",
        "\n",
        "    # Lấy k chỉ số có điểm số cao nhất (sắp xếp giảm dần)\n",
        "    top_k_idx = np.argsort(scores)[::-1][:k]\n",
        "    top_k_scores = scores[top_k_idx]\n",
        "\n",
        "    return top_k_idx, top_k_scores"
      ]
    },
