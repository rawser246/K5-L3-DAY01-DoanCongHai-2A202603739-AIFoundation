        "# 🧩 TODO 3.3 — kNN: \"hàng xóm gần nhất bỏ phiếu\"\n",
        "def knn_predict(E_train, y_train, E_query, k: int = 5) -> np.ndarray:\n",
        "    \"\"\"With each row of E_query: get k nearest messages in E_train (using top_k_similar), predict 1 if > half are spam.\"\"\"\n",
        "    preds = []\n",
        "    for q in E_query:\n",
        "        idx, _ = top_k_similar(q, E_train, k=k)\n",
        "        # Bỏ phiếu theo số lượng nhãn spam trong k hàng xóm\n",
        "        spam_count = np.sum(y_train[idx] == 1)\n",
        "        preds.append(1 if spam_count > (k / 2) else 0)\n",
        "    return np.array(preds, dtype=int)"
      ]
