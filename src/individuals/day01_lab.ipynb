        "# 🧩 TODO 4.1 — call_openai (cùng tên + tham số với template LLM API)\n",
        "def call_openai(prompt: str, model: str = OPENAI_MODEL, temperature: float = 0.7,\n",
        "                top_p: float = 0.9, max_tokens: int = 256) -> tuple[str, float]:\n",
        "    \"\"\"\n",
        "    Gọi Chat Completions, trả về (response_text, latency_seconds).\n",
        "    Gợi ý: from openai import OpenAI; client = OpenAI()\n",
        "           client.chat.completions.create(model=..., messages=[{\"role\": \"user\", \"content\": prompt}],\n",
        "                                          temperature=..., top_p=..., **provider_kwargs(max_tokens))\n",
        "           ⚠️ Với OpenAI, provider_kwargs gửi max_completion_tokens + reasoning_effort=\"none\": model GPT-6 chỉ nhận\n",
        "              temperature/top_p khi reasoning_effort=\"none\", và không nhận max_tokens → thiếu là lỗi 400.\n",
        "           đo thời gian bằng time.perf_counter(); text = resp.choices[0].message.content\n",
        "    \"\"\"\n",
        "    raise NotImplementedError\n",
        "\n",
        "def call_openai_mini(prompt: str, temperature: float = 0.7, top_p: float = 0.9, max_tokens: int = 256):\n",
        "    return call_openai(prompt, model=OPENAI_MINI_MODEL, temperature=temperature, top_p=top_p, max_tokens=max_tokens)\n",
        "\n",
        "def _retryable_errors():\n",
        "    \"\"\"Chỉ lỗi TẠM THỜI mới đáng thử lại: 429, timeout, mất kết nối, lỗi 5xx của server (SDK openai lẫn anthropic).\"\"\"\n",
        "    errs = []\n",
        "    for mod in (\"openai\", \"anthropic\"):\n",
        "        try:\n",
        "            m = __import__(mod)\n",
        "            errs += [m.RateLimitError, m.APITimeoutError, m.APIConnectionError, m.InternalServerError]\n",
        "        except (ImportError, AttributeError):\n",
        "            pass\n",
        "    return tuple(errs) or (ConnectionError, TimeoutError)\n",
        "\n",
        "def retry_with_backoff(fn, max_retries: int = 3, base_delay: float = 1.0, retry_on=None):   # ⚙️ có sẵn (bonus của template)\n",
        "    \"\"\"Thử lại fn() với độ trễ base_delay·2^attempt. Lỗi khác (sai key 401, request sai 400, NotImplementedError…)\n",
        "    được ném ra NGAY — thử lại cũng không khỏi, chỉ tốn thời gian. (SDK tự retry 2 lần trước đó.)\"\"\"\n",
        "    retry_on = retry_on or _retryable_errors()\n",
        "    for attempt in range(max_retries + 1):\n",
        "        try:\n",
        "            return fn()\n",
        "        except retry_on:\n",
        "            if attempt == max_retries:\n",
        "                raise\n",
        "            time.sleep(base_delay * 2 ** attempt)\n",
        "\n",
        "# ⚙️ Có sẵn — Claude dùng SDK chính thức `anthropic` (không đi qua lớp OpenAI-compatible)\n",
        "def call_claude(prompt: str, model: str = \"claude-haiku-5-5\", max_tokens: int = 1024) -> tuple[str, float]:\n",
        "    \"\"\"Cùng đầu ra với call_openai: (response_text, latency_seconds).\n",
        "    Model Claude hiện hành không nhận temperature/top_p; độ \"suy nghĩ\" chỉnh bằng effort (low cho phân loại).\"\"\"\n",
        "    import anthropic\n",
        "    client = anthropic.Anthropic()\n",
        "    kwargs = dict(model=model, max_tokens=max(max_tokens, 1024), output_config={\"effort\": \"low\"},\n",
        "                  messages=[{\"role\": \"user\", \"content\": prompt}])\n",
        "    t0 = time.perf_counter()\n",
        "    if model == \"claude-opus-5-5\":   # nếu bị bộ lọc an toàn từ chối, API tự chạy lại trên model dự phòng\n",
        "        resp = client.beta.messages.create(betas=[\"server-side-fallback-2026-07-01\"], fallbacks=\"default\", **kwargs)\n",
        "    else:\n",
        "        resp = client.messages.create(**kwargs)\n",
        "    latency = time.perf_counter() - t0\n",
        "    if resp.stop_reason == \"refusal\":\n",
        "        return \"\", latency\n",
        "    return \"\".join(b.text for b in resp.content if b.type == \"text\"), latency\n",
        "\n",
        "def call_llm(prompt: str, model: str, max_tokens: int = 3) -> tuple[str, float]:\n",
        "    \"\"\"⚙️ Có sẵn — gọi provider đang chọn với temperature=0. Claude → call_claude; còn lại → call_openai (của bạn).\"\"\"\n",
        "    if LLM_PROVIDER == \"anthropic\":\n",
        "        return call_claude(prompt, model=model, max_tokens=max_tokens)\n",
        "    return call_openai(prompt, model=model, temperature=0.0, max_tokens=max_tokens)"
      ]
