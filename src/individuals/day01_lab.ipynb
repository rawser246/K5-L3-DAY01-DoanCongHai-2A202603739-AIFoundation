        "# ⚙️ Tải dữ liệu từ Kaggle (dự phòng: UCI)\n",
        "import kagglehub, zipfile, io, urllib.request\n",
        "try:\n",
        "    path = kagglehub.dataset_download(\"uciml/sms-spam-collection-dataset\")\n",
        "    raw = pd.read_csv(os.path.join(path, \"spam.csv\"), encoding=\"latin-1\")[[\"v1\", \"v2\"]]\n",
        "    raw.columns = [\"label\", \"text\"]\n",
        "    print(\"Nguồn: Kaggle\")\n",
