        "# ⚙️ BÁO CÁO CUỐI — chạy lại toàn bộ notebook (Runtime → Run all) rồi chạy ô này\n",
        "n_ok = sum(_LOG[\"checks\"].values()); n_all = len(_LOG[\"checks\"])\n",
        "print(f\"SEED={SEED} · thử thách #{_LOG.get('challenge', -1) + 1}\")\n",
        "print(f\"Bộ kiểm tra: {n_ok}/{n_all} đạt\")\n",
        "for k, v in _LOG[\"checks\"].items():\n",
        "    print((\"  ✅ \" if v else \"  ❌ \") + k)\n",
        "print(\"\\nDự đoán đã ghi:\")\n",
        "for k, v in _LOG[\"predictions\"].items():\n",
        "    print(f\"  [{v['time']}] {k}: {v['text']}\")\n",
        "missing = [k for k in [\"ml_f1\", \"ml_lr\", \"dl_curve\", \"dl_relu\", \"emb_search\", \"emb_tricky\", \"llm_models\", \"llm_fewshot\", \"tradeoff\", \"hard_eval\"] if k not in _LOG[\"predictions\"]]\n",
        "print(\"Thiếu dự đoán:\", missing or \"không\")\n",
        "if RESULTS:\n",
        "    print(\"\\n\", pd.DataFrame(RESULTS).T[[\"f1\", \"f1_SUB\"]].round(3))\n",
        "with open(\"lab1_report.json\", \"w\") as f:\n",
        "    json.dump({**_LOG, \"results\": {k: {kk: float(vv) for kk, vv in v.items()} for k, v in RESULTS.items()}}, f, ensure_ascii=False, indent=1)\n",
        "print(\"\\n💾 Đã lưu lab1_report.json (chỉ chứa SEED, không chứa MSSV)\")\n",
        "try:\n",
        "    from google.colab import files\n",
        "    files.download(\"lab1_report.json\")\n",
        "except Exception:\n",
        "    pass"
      ]
    },
